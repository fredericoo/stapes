  {
    "id": "serves-while-talking",
    "name": "Serves while talking",
    "hint": "Stands still for as long as somebody is talking to it, and says its greeting when they start. Serving comes before errands and a walk home.",
    "params": {
      "greeting": {
        "kind": "text",
        "label": "greeting",
        "optional": true
      }
    },
    "states": {
      "serving": {
        "band": "need",
        "onEnter": [
          {
            "effect": "say",
            "text": {
              "arg": "greeting"
            }
          }
        ],
        "do": [
          {
            "action": "hold"
          }
        ]
      }
    },
    "triggers": [
      {
        "if": {
          "cond": "talking"
        },
        "to": "serving"
      }
    ],
    "transitions": [
      {
        "from": "serving",
        "if": {
          "combinator": "and",
          "not": true,
          "rules": [
            {
              "cond": "talking"
            }
          ]
        },
        "to": "rest"
      }
    ]
  },
