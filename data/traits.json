  {
    "id": "flees-when-hurt",
    "name": "Flees when hurt",
    "hint": "Breaks off and backs away once it is down to this share of its health with the threat still near. Healed, it goes back to what it was doing; clear, it rests.",
    "params": {
      "threat": {
        "kind": "slot",
        "holds": "body",
        "label": "from"
      },
      "below": {
        "kind": "percent",
        "label": "at or below"
      },
      "near": {
        "kind": "cells",
        "label": "while within"
      },
      "back": {
        "kind": "state",
        "default": "rest",
        "label": "healed, goes back to"
      },
      "cry": {
        "kind": "text",
        "optional": true,
        "label": "noise as it goes"
      }
    },
    "states": {
      "slinking": {
        "band": "danger",
        "onEnter": [
          {
            "effect": "noise",
            "text": {
              "arg": "cry"
            }
          }
        ],
        "do": [
          {
            "action": "step_away_from",
            "of": {
              "type": "slot",
              "data": {
                "name": "threat"
              }
            },
            "allowDrops": true
          },
          {
            "action": "hold"
          }
        ]
      }
    },
    "triggers": [
      {
        "if": {
          "combinator": "and",
          "rules": [
            {
              "cond": "health",
              "atMostPercent": {
                "arg": "below"
              }
            },
            {
              "cond": "in_range",
              "of": {
                "type": "slot",
                "data": {
                  "name": "threat"
                }
              },
              "cells": {
                "arg": "near"
              }
            }
          ]
        },
        "to": "slinking"
      }
    ],
    "transitions": [
      {
        "from": "slinking",
        "if": {
          "cond": "out_of_range",
          "of": {
            "type": "slot",
            "data": {
              "name": "threat"
            }
          },
          "cells": {
            "arg": "near"
          }
        },
        "to": "rest"
      },
      {
        "from": "slinking",
        "if": {
          "combinator": "and",
          "not": true,
          "rules": [
            {
              "cond": "health",
              "atMostPercent": {
                "arg": "below"
              }
            }
          ]
        },
        "to": "back"
      }
    ]
  },
  {
    "id": "follows-its-kind",
    "name": "Follows its kind",
    "hint": "Tags along after the nearest of its company it can see while nothing else is going on, and loses them past lose. Given settle and stray, it loiters close by and catches up when they get ahead.",
    "params": {
      "company": {
        "kind": "bodies",
        "label": "follows"
      },
      "within": {
        "kind": "cells",
        "label": "sees within"
      },
      "lose": {
        "kind": "cells",
        "label": "loses them at"
      },
      "wander": {
        "kind": "steps",
        "default": 2,
        "label": "wanders"
      },
      "settle": {
        "kind": "cells",
        "optional": true,
        "label": "loiters within"
      },
      "stray": {
        "kind": "cells",
        "optional": true,
        "label": "catches up past"
      }
    },
    "slots": {
      "leader": "body"
    },
    "states": {
      "following": {
        "band": "roam",
        "do": [
          {
            "action": "step_toward",
            "of": {
              "type": "slot",
              "data": {
                "name": "leader"
              }
            }
          },
          {
            "action": "walk_n_steps",
            "steps": {
              "arg": "wander"
            }
          }
        ]
      },
      "loitering": {
        "band": "roam",
        "do": [
          {
            "action": "walk_n_steps",
            "steps": 3
          }
        ]
      }
    },
    "triggers": [
      {
        "if": {
          "cond": "in_los",
          "of": {
            "type": "nearest",
            "data": {
              "tileIds": {
                "arg": "company"
              }
            }
          },
          "cells": {
            "arg": "within"
          }
        },
        "bind": {
          "leader": {
            "type": "nearest",
            "data": {
              "tileIds": {
                "arg": "company"
              }
            }
          }
        },
        "to": "following"
      }
    ],
    "transitions": [
      {
        "from": "following",
        "if": {
          "cond": "out_of_los",
          "of": {
            "type": "slot",
            "data": {
              "name": "leader"
            }
          },
          "cells": {
            "arg": "lose"
          }
        },
        "to": "rest"
      },
      {
        "from": "following",
        "if": {
          "cond": "in_range",
          "of": {
            "type": "slot",
            "data": {
              "name": "leader"
            }
          },
          "cells": {
            "arg": "settle"
          }
        },
        "to": "loitering"
      },
      {
        "from": "loitering",
        "if": {
          "cond": "out_of_range",
          "of": {
            "type": "slot",
            "data": {
              "name": "leader"
            }
          },
          "cells": {
            "arg": "stray"
          }
        },
        "to": "following"
      }
    ]
  },
  {
    "id": "townsfolk-flee",
    "name": "Townsfolk who flee",
    "hint": "Runs from whoever hits it, walks home once they are out of reach or it has run long enough, and snacks with a spell of its own whenever it is not fed and nobody is talking to it. Given a state to listen in, it goes there whenever somebody talks to it, and comes back to rest from a walk home or a snack the same way.",
    "params": {
      "cry": {
        "kind": "text",
        "default": "Please, don't hurt me!",
        "label": "says as it runs"
      },
      "snack": {
        "kind": "spell",
        "label": "snacks with"
      },
      "talk": {
        "kind": "state",
        "optional": true,
        "label": "listens in"
      },
      "calm": {
        "kind": "cells",
        "default": 10,
        "label": "runs while within"
      },
      "panic": {
        "kind": "ms",
        "default": 12000,
        "label": "runs for at most"
      },
      "recover": {
        "kind": "ms",
        "default": 20000,
        "label": "walks home for at most"
      }
    },
    "slots": {
      "threat": "body"
    },
    "let": {
      "hungry": {
        "kind": "condition",
        "value": {
          "combinator": "and",
          "rules": [
            {
              "combinator": "and",
              "not": true,
              "rules": [
                {
                  "cond": "status",
                  "id": "fed"
                }
              ]
            },
            {
              "combinator": "and",
              "not": true,
              "rules": [
                {
                  "cond": "talking"
                }
              ]
            }
          ]
        }
      }
    },
    "states": {
      "panicking": {
        "band": "danger",
        "onEnter": [
          {
            "effect": "say",
            "text": {
              "arg": "cry"
            }
          }
        ],
        "do": [
          {
            "action": "step_away_from",
            "of": {
              "type": "slot",
              "data": {
                "name": "threat"
              }
            }
          },
          {
            "action": "hold"
          }
        ]
      },
      "recovering": {
        "band": "need",
        "do": [
          {
            "action": "step_toward",
            "of": {
              "type": "home"
            }
          },
          {
            "action": "hold"
          }
        ]
      },
      "snacking": {
        "band": "need",
        "do": [
          {
            "action": "cast",
            "spell": {
              "arg": "snack"
            }
          },
          {
            "action": "hold"
          }
        ]
      }
    },
    "triggers": [
      {
        "band": "danger",
        "retarget": true,
        "if": {
          "cond": "attacked"
        },
        "bind": {
          "threat": {
            "type": "attacker"
          }
        },
        "to": "panicking"
      },
      {
        "band": "need",
        "retarget": true,
        "if": {
          "arg": "hungry"
        },
        "to": "snacking"
      },
      {
        "band": "roam",
        "retarget": true,
        "if": {
          "cond": "talking"
        },
        "to": "talk"
      }
    ],
    "transitions": [
      {
        "from": "panicking",
        "if": {
          "combinator": "and",
          "rules": [
            {
              "cond": "in_range",
              "of": {
                "type": "slot",
                "data": {
                  "name": "threat"
                }
              },
              "cells": {
                "arg": "calm"
              }
            },
            {
              "combinator": "and",
              "not": true,
              "rules": [
                {
                  "cond": "after",
                  "ms": {
                    "arg": "panic"
                  }
                }
              ]
            }
          ]
        },
        "to": "panicking"
      },
      {
        "from": "panicking",
        "if": {
          "cond": "after",
          "ms": 0
        },
        "to": "recovering"
      },
      {
        "from": "recovering",
        "if": {
          "cond": "in_range",
          "of": {
            "type": "home"
          },
          "cells": 1
        },
        "to": "rest"
      },
      {
        "from": "recovering",
        "if": {
          "cond": "after",
          "ms": {
            "arg": "recover"
          }
        },
        "to": "rest"
      },
      {
        "from": "recovering",
        "if": {
          "arg": "hungry"
        },
        "to": "snacking"
      },
      {
        "from": "recovering",
        "if": {
          "cond": "talking"
        },
        "to": "talk"
      },
      {
        "from": "snacking",
        "if": {
          "cond": "status",
          "id": "fed"
        },
        "to": "rest"
      },
      {
        "from": "snacking",
        "if": {
          "cond": "talking"
        },
        "to": "talk"
      }
    ]
  },
