{
  "include": ["app/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    // The app is a browser bundle. It used to exclude Node types so a `node:`
    // import failed here rather than on deploy to workerd; the reason is
    // different now and the rule is the same — this code runs in a tab.
    "types": ["vite/client"],
    "target": "ES2022",
    // Vite compiles this, not `tsc`, so `preserve` is the honest setting: it
    // leaves every import shape alone and lets the bundler resolve them.
    "module": "preserve",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./app/*"] },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
