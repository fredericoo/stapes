{
  "name": "stapes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:r2": "VITE_USE_R2=1 react-router dev",
    "dev:worker": "pnpm build && tsx scripts/dev-worker.ts",
    "deploy": "pnpm build && wrangler deploy",
    "seed": "tsx scripts/seed-r2.ts",
    "typecheck": "react-router typegen && wrangler types && tsc && tsc -p tsconfig.node.json",
    "generate": "tsx scripts/generate-tilesets.ts",
    "generate:complement": "tsx scripts/generate-autotile-complement.ts",
    "test": "pnpm test:unit && pnpm test:workers && pnpm test:perf",
    "test:unit": "vitest run",
    "test:perf": "playwright test",
    "test:workers": "vitest run -c vitest.workers.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/react": "^0.5.0",
    "@tabler/icons-react": "^3.46.0",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "react-splitkit": "^0.1.0",
    "three": "^0.185.1",
    "unique-names-generator": "^4.7.1",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
