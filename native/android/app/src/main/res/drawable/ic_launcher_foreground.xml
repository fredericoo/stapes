<?xml version="1.0" encoding="utf-8"?>
<!--
     One tile, drawn the way the game draws every tile: an oblique cabinet
     projection, where the front face is a true square and the depth axis runs
     at 45 degrees at half length. Three faces and three flat tones, no
     gradient and no outline — the same thing the renderer puts on screen.

     A vector rather than a set of PNGs per density, which is the whole reason
     this is a shape a file can describe: there is no bitmap to regenerate when
     somebody wants it bigger. Sized to sit inside the 72dp safe zone, so no
     launcher's mask can clip a corner off it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The lid. -->
    <path
        android:fillColor="#F4F0E6"
        android:pathData="M28,46 L46,28 L82,28 L64,46 Z" />
    <!-- The face you are looking at. -->
    <path
        android:fillColor="#EBE6D8"
        android:pathData="M28,46 L64,46 L64,82 L28,82 Z" />
    <!-- The side turning away, darkest of the three. -->
    <path
        android:fillColor="#B8B2A1"
        android:pathData="M64,46 L82,28 L82,64 L64,82 Z" />
</vector>
