{
  // Build tooling and test harnesses: the tileset generators, the dev runner,
  // the seeder, the Vite/Vitest/Playwright configs and the Playwright specs.
  // These run in Bun or Node rather than in a tab.
  "include": ["scripts/**/*", "e2e/**/*", "*.config.ts"],
  "compilerOptions": {
    // DOM for the Playwright specs: page.evaluate callbacks are typed here but
    // execute in the browser.
    "lib": ["ES2022", "DOM"],
    "types": ["node", "bun"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
